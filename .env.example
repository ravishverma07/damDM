# ==========================================================
# DamDM by DammAI - environment configuration
# Copy to .env and fill in. NEVER commit the real .env file.
# ==========================================================

# --- Django core ---
DEBUG=True
SECRET_KEY=change-me-generate-with-get_random_secret_key
ALLOWED_HOSTS=localhost,127.0.0.1
# Public URL of this app. Instagram only redirects to HTTPS, so for real Instagram
# sign-in in development run a tunnel (e.g. `ngrok http 8000`) and put its https URL
# here. Redirect URIs, allowed hosts and CSRF origins are derived from it.
APP_BASE_URL=http://localhost:8000

# --- Database ---
# Local default (no server needed):
DATABASE_URL=sqlite:///db.sqlite3
# Production / Postgres:
# DATABASE_URL=postgres://damdm:damdm@localhost:5432/damdm

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=False

# --- Meta / Instagram (Instagram API with Instagram Login) ---
# Instagram sign-in: developers.facebook.com -> My Apps -> your app (type Business)
# -> Instagram -> "API setup with Instagram business login". Copy the *Instagram* app
# ID and secret (not the Facebook app ones). Under "Set up Instagram business login"
# -> Business login settings, add OAuth redirect URI: <APP_BASE_URL>/instagram/callback/
# Leave META_REDIRECT_URI empty to derive it from APP_BASE_URL.
# Set META_MOCK=False to use the real Instagram login.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0
META_MOCK=True

# --- Google sign-in ---
# console.cloud.google.com -> APIs & Services -> OAuth consent screen (External; add
# yourself as a test user) -> Credentials -> Create credentials -> OAuth client ID
# (Web application). Authorised redirect URI: <APP_BASE_URL>/accounts/google/callback/
# Leave GOOGLE_REDIRECT_URI empty to derive it from APP_BASE_URL.
# Set GOOGLE_MOCK=False to use the real Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_MOCK=True

# --- Token encryption (separate from SECRET_KEY) ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Salt used for hashing click IPs (never store raw IPs) ---
IP_HASH_SALT=change-me

# --- Billing: Razorpay (UPI AutoPay subscriptions) ---
# dashboard.razorpay.com -> Account & Settings -> API Keys (use Test Mode keys first).
# Subscriptions -> Plans -> Create plan: ₹99, monthly -> copy its plan_... id.
# Webhooks -> Add: <APP_BASE_URL>/billing/webhooks/razorpay/ with a secret, events:
#   subscription.authenticated, .activated, .charged, .pending, .halted,
#   .cancelled, .completed, .paused, .resumed, payment.failed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_MOCK=True
DEFAULT_CURRENCY=INR

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=DamDM <no-reply@dm.dammai.in>
