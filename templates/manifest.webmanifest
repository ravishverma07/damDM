{% load static %}{
  "name": "{{ APP_NAME }}",
  "short_name": "{{ APP_NAME }}",
  "description": "Instagram DM automation",
  "id": "/",
  "start_url": "/dashboard/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "icons": [
    {"src": "{% static 'img/icon-192.png' %}", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "{% static 'img/icon-512.png' %}", "sizes": "512x512", "type": "image/png", "purpose": "any"}
  ]
}
